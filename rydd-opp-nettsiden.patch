+<!doctype html>
+<html lang="no">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+    <title>BiB - Oliver Sund</title>
+    <link rel="stylesheet" href="../../styles.css" />
+  </head>
+
+  <body class="portfolio">
+    <div class="portfolio-page">
+      <div class="portfolio-container">
+        <header class="portfolio-header">
+          <a href="../../kontakt.html" class="portfolio-back">← Tilbake</a>
+        </header>
+
+        <main>
+          <section class="portfolio-hero">
+            <h1 class="portfolio-title">Oliver Sund</h1>
+            <p class="portfolio-subtitle">Bolig i Bergen</p>
+          </section>
+
+          <section class="portfolio-image-section">
+            <img class="portfolio-image" src="Oliver_bilde.jpg" alt="Oliver Sund" />
+          </section>
+
+          <section class="portfolio-content">
+            <div class="portfolio-content-label">Om prosjektet</div>
+
+            <div class="portfolio-description">
+              <p>
+                Her skal jeg skrive om hva som helst jeg vil. Derfor har jeg
+                tenkt å skrive om ting som jeg har lyst å skrive om.
+              </p>
+
+              <p>
+                Dette prosjektet er et skoleprosjekt hvor vi 7 ble plassert
+                inn i denne gruppen siden ingen av oss var med på
+                orienteringen. Prosjektet går ut på at vi skal lage ei
+                nettside som handler om boliger i Bergen. Vi måtte gå gjennom
+                brukerhistorier som sier hva som skal være på siden.
+              </p>
+
+              <p>
+                En av brukerhistoriene sier: "Informasjon om oppussing. Som
+                boligeier er det alltid aktuelt med oppussing. Lag informasjon
+                som oppussing av bad, fornyelse kjøkken, legging av parkett.
+                Skifte av vinduer. Lenker til oppussingsfirma?" Dette var den
+                jeg tok hånd om. Jeg tenkte det smarteste å gjøre var å lage
+                en tabell med noen produkter fra nettsider som Kid og
+                Plantasjen. Det fungerte ganske greit.
+              </p>
+            </div>
+          </section>
+        </main>
+
+        <footer class="portfolio-footer">
+          <span>Oliver Sund</span>
+        </footer>
+      </div>
+    </div>
+  </body>
+</html>
